<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <!-- without for loops -->
    <ul>
        <li>
            <%=users[0] %>
        </li>
        <li>
            <%=users[1] %>
        </li>
        <li>
            <%=users[2] %>
        </li>
    </ul>

    <!-- using for loops -->

    <ul>
        <% for(let user of users){ %>
            <li>
                <%= user %>
            </li>
            <% } %>
    </ul>
</body>

</html>